			count: 2
			path: src/FeedbackServiceProvider.php

		-
			message: '#^Method InternetGuru\\LaravelFeedback\\FeedbackServiceProvider\:\:boot\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/FeedbackServiceProvider.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:isAdmin\(\)\.$#'
